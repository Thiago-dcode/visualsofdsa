// use prisma-8

enum UserRole {
  ADMIN
  USER
}

model User {
  id                     Int                          @id @default(autoincrement())
  email                  String                       @unique
  password               String?
  name                   String?
  avatar                 String?
  favoriteDataStructures UserFavoriteDataStructure[]
  favoriteAlgorithms     UserFavoriteAlgorithm[]
  settingsId             Int?
  settings               UserSetting?                 @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @default(now()) @onUpdate(now())
}

model UserSetting {
  id                 Int      @id @default(autoincrement())
  userId             Int
  allowNotifications Boolean  @default(false)
  user               User[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @onUpdate(now())
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @onUpdate(now())
}

model DataStructure {
  id                            Int                          @id @default(autoincrement())
  name                          String                       @unique
  enable                        Boolean                      @default(false)
  link                          String                       @unique
  order                         Int?                         @default(0)
  metaDescription               String?
  description                   String?
  dataStructureTypeId           Int
  dataStructureImplementationId Int?
  implementation                DataStructureImplementation? @relation(fields: [dataStructureImplementationId], references: [id], onDelete: Cascade)
  type                          DataStructureType            @relation(fields: [dataStructureTypeId], references: [id], onDelete: Cascade)
  favoriteUsers                 UserFavoriteDataStructure[]
}

model UserFavoriteDataStructure {
  userId          Int
  dataStructureId Int
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataStructure   DataStructure @relation(fields: [dataStructureId], references: [id], onDelete: Cascade)

  @@id([userId, dataStructureId])
}

model DataStructureType {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  description     String
  enable          Boolean         @default(false)
  link            String          @unique
  children        DataStructure[]
  metaDescription String?
}

model DataStructureImplementation {
  id         Int             @id @default(autoincrement())
  javaScript String?
  java       String?
  children   DataStructure[]
}

model Algorithm {
  id                        Int                      @id @default(autoincrement())
  name                      String                   @unique
  enable                    Boolean                  @default(false)
  link                      String                   @unique
  order                     Int?                     @default(0)
  metaDescription           String?
  description               String?
  algorithmTypeId           Int
  algorithmImplementationId Int?
  implementation            AlgorithmImplementation? @relation(fields: [algorithmImplementationId], references: [id], onDelete: Cascade)
  type                      AlgorithmType            @relation(fields: [algorithmTypeId], references: [id], onDelete: Cascade)
  favoriteUsers             UserFavoriteAlgorithm[]
}

model UserFavoriteAlgorithm {
  userId      Int
  algorithmId Int
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  algorithm   Algorithm @relation(fields: [algorithmId], references: [id], onDelete: Cascade)

  @@id([userId, algorithmId])
}

model AlgorithmType {
  id              Int         @id @default(autoincrement())
  name            String      @unique
  description     String
  link            String      @unique
  enable          Boolean     @default(false)
  children        Algorithm[]
  metaDescription String?
}

model AlgorithmImplementation {
  id         Int         @id @default(autoincrement())
  javaScript String?
  java       String?
  children   Algorithm[]
}
